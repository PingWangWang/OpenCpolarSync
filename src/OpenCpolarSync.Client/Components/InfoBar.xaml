<UserControl x:Class="OpenCpolarSync.Client.Components.InfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="320">
    <Border x:Name="RootBorder" CornerRadius="8" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 图标 -->
            <TextBlock x:Name="IconText" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <!-- 文字 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="600" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="ContentText" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 关闭按钮 -->
            <Button x:Name="CloseButton" Grid.Column="2" Content="✕" FontSize="10" Width="24" Height="24"
                    VerticalAlignment="Center" Margin="8,0,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="{DynamicResource TextTertiary}" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</UserControl>
